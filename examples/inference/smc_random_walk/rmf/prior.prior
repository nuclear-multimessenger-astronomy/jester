# RMF EOS prior: meson masses fixed (as in CompactObject's own RMF inference examples,
# e.g. Test_Case/test_Inference.ipynb and Huang et al. 2023, arXiv:2303.17518), only the
# 7 coupling constants are sampled. Ranges bracket the priors used in that same notebook
# (which uses Normal/flat priors on the couplings or their squares; the ranges below are
# generous Uniform brackets around those, not a literal reproduction).

m_sig = Fixed(2.5084883190594436, parameter_names=["m_sig"])   # 495 MeV / hbar*c
m_w = Fixed(3.96544, parameter_names=["m_w"])
m_rho = Fixed(3.86662, parameter_names=["m_rho"])

g_sigma = UniformPrior(9.0, 11.5, parameter_names=["g_sigma"])
g_omega = UniformPrior(12.2, 14.5, parameter_names=["g_omega"])
g_rho = UniformPrior(8.6, 14.5, parameter_names=["g_rho"])
kappa = UniformPrior(-0.01, 0.04, parameter_names=["kappa"])
lambda_0 = UniformPrior(-0.06, 0.07, parameter_names=["lambda_0"])
zeta = UniformPrior(0.0, 0.04, parameter_names=["zeta"])
Lambda_w = UniformPrior(0.0, 0.045, parameter_names=["Lambda_w"])
